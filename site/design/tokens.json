{
  "$name": "PROKOP — design tokens",
  "$version": "1.0",
  "$date": "2026-09-24",
  "$source": "design/tokens.css",
  "$note": "Тёмная тема по умолчанию. Палитра названа по пигментам старопечатной книги и меднолитой иконы.",
  "color": {
    "pigments": {
      "soot":   { "900": "#0B0A09", "800": "#141210", "700": "#1D1A17", "600": "#2A2622", "500": "#3B3530" },
      "paper":  { "50": "#F4EDDD", "100": "#E7DCC6", "200": "#D3C4A8" },
      "cinnabar":   { "300": "#F2705C", "500": "#D8382B", "700": "#B02A20" },
      "verdigris":  { "300": "#57D9B4", "500": "#2F9E82", "700": "#1F6E5A" },
      "gold":       { "300": "#E0A75C", "500": "#C8873C", "700": "#7A4E14" },
      "ultramarine":{ "300": "#6B8FE0", "500": "#2B4C8C" },
      "copper":     { "300": "#C48A6A", "500": "#9A5B3B" }
    },
    "roles": {
      "dark": {
        "bg": "#0B0A09", "bg-subtle": "#141210", "surface": "#141210", "surface-2": "#1D1A17",
        "border": "#2A2622", "border-strong": "#3B3530",
        "text": "#F4EDDD", "text-2": "#E7DCC6", "muted": "#A99C86",
        "accent": "#D8382B", "accent-text": "#F2705C",
        "accent-2": "#2F9E82", "accent-2-text": "#57D9B4",
        "gold": "#C8873C", "gold-text": "#E0A75C",
        "link": "#6B8FE0", "on-accent": "#F4EDDD", "on-gold": "#0B0A09"
      },
      "light": {
        "bg": "#F4EDDD", "bg-subtle": "#EDE4D2", "surface": "#FAF5EA", "surface-2": "#E7DCC6",
        "border": "#D3C4A8", "border-strong": "#BCA98A",
        "text": "#16130F", "text-2": "#3D372E", "muted": "#6B6355",
        "accent": "#D8382B", "accent-text": "#B02A20",
        "accent-2": "#1F6E5A", "accent-2-text": "#1F6E5A",
        "gold": "#C8873C", "gold-text": "#7A4E14",
        "link": "#2B4C8C", "on-accent": "#F4EDDD", "on-gold": "#0B0A09"
      }
    }
  },
  "contrast": {
    "$method": "WCAG 2.x, sRGB относительная яркость",
    "$rule": "мелкий текст ≥ 4.5:1, крупный ≥ 3:1. Средние тона киновари и яри намеренно не используются для мелкого текста.",
    "dark": {
      "text/bg": "16.96:1",
      "text-2/bg": "13.92:1",
      "muted/bg": "7.15:1",
      "accent-text/bg": "6.83:1",
      "accent-2-text/bg": "11.30:1",
      "gold-text/bg": "8.05:1",
      "link/bg": "6.25:1",
      "on-accent/accent": "4.26:1 — только крупный текст и графика, для мелкого берём accent-text"
    },
    "light": {
      "text/bg": "15.62:1",
      "text-2/bg": "9.80:1",
      "muted/bg": "5.30:1",
      "accent-text/bg": "5.63:1",
      "accent-2-text/bg": "5.24:1",
      "gold-text/bg": "6.15:1",
      "link/bg": "7.90:1",
      "accent/bg": "3.98:1 — только крупный текст и заливки"
    },
    "rejected": {
      "cinnabar-500/soot-900": "4.26:1 — ниже 4.5",
      "cinnabar-500/paper-50": "3.98:1 — ниже 4.5",
      "verdigris-500/paper-50": "2.84:1 — ниже 4.5",
      "ultramarine-500/soot-900": "2.37:1 — ниже 4.5"
    }
  },
  "typography": {
    "family": {
      "display": "'Fedorovsk', 'Old Standard TT', Georgia, 'Times New Roman', serif",
      "module": "'Handjet', 'JetBrains Mono', ui-monospace, monospace",
      "body": "'Golos Text', -apple-system, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace"
    },
    "roles": {
      "display": "Fedorovsk — заголовки h1–h3, буквица, заставки. Только акциденция, никогда абзацы.",
      "module": "Handjet — метки, надзаголовки, статусы, номера, вывод терминала. Ось ELSH в квадрат.",
      "body": "Golos Text — абзацы, интерфейс, кнопки.",
      "mono": "JetBrains Mono — код, фрагменты CLI, идентификаторы, данные."
    },
    "size": {
      "h1": "clamp(2rem, 1.25rem + 3.4vw, 3.5rem)",
      "h2": "clamp(1.5rem, 1.1rem + 1.8vw, 2.25rem)",
      "h3": "clamp(1.125rem, 1rem + 0.6vw, 1.4375rem)",
      "h4": "1.125rem",
      "lead": "clamp(1.0625rem, 1rem + 0.5vw, 1.3125rem)",
      "body": "1.0625rem",
      "sm": "0.9375rem",
      "caption": "0.875rem",
      "mark": "0.8125rem — только модульные метки"
    },
    "lineHeight": { "tight": "1.08", "head": "1.18", "snug": "1.4", "body": "1.62" },
    "tracking": { "display": "-0.01em", "mark": "0.14em" },
    "measure": "66ch",
    "licenses": {
      "Fedorovsk": "SIL OFL 1.1 (Slavonic Computing Initiative, альтернативная ветка GPLv3 не используется)",
      "Handjet": "SIL OFL 1.1 (Rosetta, David Březina)",
      "Golos Text": "SIL OFL 1.1 (Paratype)",
      "JetBrains Mono": "SIL OFL 1.1 (JetBrains)"
    }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px" },
  "layout": { "container": "1120px", "gutter": "32px", "gutterMobile": "20px", "sectionY": "80px", "sectionYMobile": "48px", "module": "8px" },
  "radius": { "xs": "3px", "sm": "5px", "md": "8px", "lg": "12px", "xl": "18px", "full": "999px" },
  "motion": { "durFast": "130ms", "durBase": "220ms", "durSlow": "340ms", "ease": "cubic-bezier(0.2, 0, 0, 1)" },
  "zIndex": { "header": 200, "modal": 400 },
  "logo": {
    "files": {
      "sign-accent": "design/logo/sign-accent.svg",
      "sign-paper": "design/logo/sign-paper.svg",
      "sign-soot": "design/logo/sign-soot.svg",
      "favicon": "design/logo/favicon.svg",
      "wordmark-paper": "design/logo/wordmark-paper.svg",
      "wordmark-soot": "design/logo/wordmark-soot.svg",
      "lockup-accent": "design/logo/lockup-accent.svg",
      "lockup-paper": "design/logo/lockup-paper.svg",
      "lockup-soot": "design/logo/lockup-soot.svg"
    },
    "construction": {
      "signGrid": "13 × 13 модулей, центр 6.5,6.5",
      "ring": "12 модулей радиуса 5 — обвес",
      "core": "осмиконечный крест из тех же модулей — ядро",
      "tiltedBar": "единственный элемент вне сетки: повёрнут на −19.3°, как сама косая перекладина",
      "moduleRadius": "0.14 от стороны модуля"
    },
    "clearSpace": "1 модуль знака (1/13 стороны)",
    "minSize": { "sign": "24px", "lockup": "120px" },
    "ratio": { "sign": "1:1", "wordmark": "35:7", "lockup": "50:13" }
  }
}
